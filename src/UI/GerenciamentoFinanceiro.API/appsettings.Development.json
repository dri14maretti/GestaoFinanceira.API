{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=gestaofinanceira;Username=postgres;Password=postgrespassword"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "GestaoFinanceira.API",
    "Audience": "GestaoFinanceira.Client",
    "SigningKey": "DevelopmentSecretKeyForGestaoFinanceiraApiOnlyMustBeLongerThan32Bytes!",
    "AccessTokenMinutes": 15,
    "SessionDays": 30
  },
  "RefreshCookie": {
    "CookieName": "gf_refresh",
    "Secure": false,
    "SameSite": "Strict",
    "Path": "/api/auth"
  }
}
