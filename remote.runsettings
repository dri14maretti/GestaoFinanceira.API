<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configuration for test execution -->
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TargetPlatform>x64</TargetPlatform>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
  </RunConfiguration>

  <!-- Parameters for remote / external testing -->
  <TestRunParameters>
    <Parameter name="ApiBaseUrl" value="https://api.gestaofinanceira.com" />
    <Parameter name="TargetEnvironment" value="Published" />
  </TestRunParameters>

  <!-- Environment Variables injected into test process -->
  <EnvironmentVariables>
    <!-- Configure with your external published server URL (e.g. Staging, Production, Cloud Run, AWS, etc.) -->
    <API_BASE_URL>https://api.gestaofinanceira.com</API_BASE_URL>
  </EnvironmentVariables>
</RunSettings>
