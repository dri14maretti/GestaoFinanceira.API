<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configuration for test execution -->
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TargetPlatform>x64</TargetPlatform>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
  </RunConfiguration>

  <!-- Parameters for local testing -->
  <TestRunParameters>
    <Parameter name="ApiBaseUrl" value="http://localhost:5230" />
    <Parameter name="TargetEnvironment" value="Local" />
  </TestRunParameters>

  <!-- Environment Variables injected into test process -->
  <EnvironmentVariables>
    <!-- URL of the locally running API (started via dotnet run) -->
    <API_BASE_URL>http://localhost:5230</API_BASE_URL>
  </EnvironmentVariables>
</RunSettings>
